  if(c)db.prepare("DELETE FROM cart_items WHERE cart_id=? AND listing_id=?").run(c.id,req.params.listing_id);
  res.json({ok:true});
});

app.post("/api/orders",auth,(req,res)=>{
  const {delivery_method="pickup",delivery_address=""}=req.body;
  const c=db.prepare("SELECT * FROM carts WHERE user_id=?").get(req.user.id);
  if(!c)return res.status(400).json({error:"Panier vide"});
  const items=db.prepare(`SELECT ci.*,l.* FROM cart_items ci JOIN listings l ON l.id=ci.listing_id WHERE ci.cart_id=?`).all(c.id);
  if(!items.length)return res.status(400).json({error:"Panier vide"});
  const sellers=[...new Set(items.map(x=>x.owner_id))];
  if(sellers.length>1)return res.status(400).json({error:"Pour cette V1, commandez séparément par vendeur"});
  const total=items.reduce((s,x)=>s+x.price*x.quantity,0), currency=items[0].currency;
  const oid=id();
  db.prepare("INSERT INTO orders VALUES (?,?,?,?,?,?,?,?)").run(oid,req.user.id,sellers[0],total,currency,"pending",delivery_method,delivery_address,now());
  const ins=db.prepare("INSERT INTO order_items VALUES (?,?,?,?,?)");
  for(const x of items) ins.run(id(),oid,x.id,x.title,x.quantity,x.price);
  db.prepare("DELETE FROM cart_items WHERE cart_id=?").run(c.id);
  notify(sellers[0],"Nouvelle commande",`Une commande ${oid.slice(0,8)} a été créée.`);
  res.json({id:oid,total,currency,status:"pending"});
});
