app.get("/api/listings",(req,res)=>{
  const {q="",type="",category="",country="",limit=100}=req.query;
  let sql=`SELECT l.*,u.name owner_name,b.name business_name,
    COALESCE((SELECT AVG(r.rating) FROM reviews r WHERE r.listing_id=l.id),0) rating
    FROM listings l JOIN users u ON u.id=l.owner_id LEFT JOIN businesses b ON b.id=l.business_id
    WHERE l.status='active'`;
  const p=[];
  if(q){sql+=" AND (l.title LIKE ? OR l.description LIKE ? OR l.category LIKE ? OR l.location LIKE ?)"; const x=`%${q}%`;p.push(x,x,x,x);}
  if(type){sql+=" AND l.type=?";p.push(type)}
  if(category){sql+=" AND l.category=?";p.push(category)}
  if(country){sql+=" AND u.country=?";p.push(country)}
  sql+=" ORDER BY l.created_at DESC LIMIT ?";p.push(Number(limit));
  res.json(db.prepare(sql).all(...p));
});

app.post("/api/listings",auth,(req,res)=>{
  const {type,title,description="",category="",price=0,currency="HTG",quantity=1,location="",availability="",image="",business_id=null}=req.body;
  if(!["product","service"].includes(type)||!title) return res.status(400).json({error:"Type et titre requis"});
  if(blocked(`${title} ${description} ${category}`)) return res.status(400).json({error:"Cette annonce est bloquée par la sécurité HELPY"});
  const x={id:id(),owner_id:req.user.id,business_id,type,title,description,category,price:Number(price),currency,quantity:Number(quantity),location,availability,image,status:"active",created_at:now()};
  db.prepare(`INSERT INTO listings (id,owner_id,business_id,type,title,description,category,price,currency,quantity,location,availability,image,status,created_at)
  VALUES (@id,@owner_id,@business_id,@type,@title,@description,@category,@price,@currency,@quantity,@location,@availability,@image,@status,@created_at)`).run(x);
  res.json(x);
});

