app.post("/api/cart",auth,(req,res)=>{
  const {listing_id,quantity=1}=req.body; const l=db.prepare("SELECT * FROM listings WHERE id=? AND status='active'").get(listing_id);
  if(!l)return res.status(404).json({error:"Annonce introuvable"});
  let c=db.prepare("SELECT * FROM carts WHERE user_id=?").get(req.user.id);
  if(!c){c={id:id(),user_id:req.user.id,created_at:now()};db.prepare("INSERT INTO carts VALUES (?,?,?)").run(...Object.values(c));}
  db.prepare(`INSERT INTO cart_items VALUES (?,?,?,?) ON CONFLICT(cart_id,listing_id) DO UPDATE SET quantity=quantity+excluded.quantity`).run(id(),c.id,listing_id,Number(quantity));
  res.json({ok:true});
});
app.delete("/api/cart/:listing_id",auth,(req,res)=>{
