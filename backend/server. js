const express = require("express");

const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());

app.get("/", (req, res) => {
  res.json({
    app: "HELPY",
    status: "online",
    message: "HELPY backend is working 🚀"
  });
});

app.get("/api/health", (req, res) => {
  res.json({
    status: "ok",
    service: "HELPY"
  });
});

app.listen(PORT, () => {
  console.log(`HELPY server running on port ${PORT}`);
});
